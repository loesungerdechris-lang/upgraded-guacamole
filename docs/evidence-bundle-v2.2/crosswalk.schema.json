{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "crosswalk_revision",
    "status",
    "validated_scope",
    "specification_status",
    "v22_coverage",
    "production_acceptance",
    "limitations",
    "baseline",
    "requirements"
  ],
  "properties": {
    "version": {
      "const": "2.2"
    },
    "crosswalk_revision": {
      "const": "0.1"
    },
    "status": {
      "const": "draft"
    },
    "validated_scope": {
      "const": "M2"
    },
    "specification_status": {
      "const": "canonical-source-not-established"
    },
    "v22_coverage": {
      "const": "incomplete"
    },
    "production_acceptance": {
      "const": false
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance_mock",
        "demo_provenance",
        "hsm_validated",
        "azure_key_vault_validated",
        "production_trust_established"
      ],
      "properties": {
        "governance_mock": {
          "const": true
        },
        "demo_provenance": {
          "const": true
        },
        "hsm_validated": {
          "const": false
        },
        "azure_key_vault_validated": {
          "const": false
        },
        "production_trust_established": {
          "const": false
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "commit",
        "run_id"
      ],
      "properties": {
        "path": {
          "const": "docs/evidence-bundle-v2.2/evidence/m2-observation.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "milestone",
          "coverage",
          "canonical_ref",
          "implementation",
          "rule",
          "evidence",
          "tests",
          "related_tests",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(M2-MUT-[0-9]{2}|(?:EB|GOV|TR|PORT)-[0-9]{3})$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          },
          "milestone": {
            "enum": [
              "M2",
              "M3",
              "M4",
              "M5"
            ]
          },
          "coverage": {
            "enum": [
              "covered",
              "partial",
              "open"
            ]
          },
          "canonical_ref": {
            "type": "null"
          },
          "implementation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^[^\\r\\n]+$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "predicate_type",
                "locator"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^[^\\r\\n]+$"
                },
                "predicate_type": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 500
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^[^\\r\\n]+$"
                }
              }
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario",
                "exit_name",
                "exit_code"
              ],
              "properties": {
                "scenario": {
                  "type": "string",
                  "pattern": "^[a-z]+(?:-[a-z]+)*$"
                },
                "exit_name": {
                  "type": "string",
                  "pattern": "^[A-Z]+(?:_[A-Z]+)*$"
                },
                "exit_code": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 89
                }
              }
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "related_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^[^\\r\\n]+$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "coverage": {
                  "const": "covered"
                }
              }
            },
            "then": {
              "properties": {
                "milestone": {
                  "const": "M2"
                },
                "implementation": {
                  "minItems": 1
                },
                "evidence": {
                  "minItems": 1
                },
                "tests": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SENTINEL local crosswalk draft structure (not the canonical v2.2 specification)"
}
