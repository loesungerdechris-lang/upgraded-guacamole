{
  "schema_version": "sentinel.historical-web.source-policy.v1-draft",
  "source_id": "memento-timemap",
  "source_class": "memento-discovery",
  "status": "HOLD",
  "enabled": false,
  "acquisition_authority": "separate_policy_required",
  "network": {
    "timemap_base_url": null,
    "allowed_timemap_hosts": [],
    "allowed_source_archive_hosts": [],
    "method": "GET",
    "follow_redirects": false,
    "send_credentials": false,
    "send_cookies": false,
    "requires_reviewed_transport": true,
    "timeout_seconds": 20,
    "max_attempts": 3,
    "max_response_bytes": 8388608,
    "max_mementos": 1000,
    "honor_retry_after": true,
    "aggressive_parallelism": false
  },
  "capabilities": {
    "timemap_discovery": false,
    "timemap_response_hashing": true,
    "memento_content_acquisition": false,
    "source_archive_identity_verified": false,
    "memento_datetime_verified": false,
    "active_content_execution": false,
    "recursive_timemap_following": false,
    "automatic_status_elevation": false,
    "publication": false
  },
  "result_classes": [
    "SUCCESS",
    "PARTIAL",
    "PAGINATION_REQUIRED",
    "NOT_FOUND",
    "QUERY_FAILED",
    "POLICY_BLOCKED"
  ],
  "required_reviews": [
    "source_terms",
    "privacy",
    "provenance",
    "security",
    "transport",
    "sentinel_activation"
  ],
  "limitations": [
    "Memento is discovery provenance, not the provenance of the underlying capture",
    "A source_archive value is declared by the candidate Memento URI and remains unverified until separate acquisition",
    "A Memento datetime is aggregator metadata and remains unverified until source-specific acquisition",
    "Index and paging TimeMaps are reported but never followed automatically",
    "A missing Memento result does not prove historical non-existence",
    "Cross-source agreement does not establish factual truth or release authority"
  ]
}
